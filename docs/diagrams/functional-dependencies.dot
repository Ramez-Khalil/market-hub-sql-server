digraph G {
 graph [bgcolor="#F8FAFC", pad="0.35", nodesep="0.45", ranksep="0.75", fontname="DejaVu Sans", fontsize=20, labelloc=t, labeljust=l];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10];
 edge [fontname="DejaVu Sans", fontsize=9, color="#64748B", arrowsize=0.7];
 label="MARKETHUB / Primary-key functional dependencies"; rankdir=TB;
CUSTOMER [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>CUSTOMER</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: CustomerId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">FirstName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">LastName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Phone</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StreetAddress</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">City</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StateCode</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PostalCode</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Email</TD></TR></TABLE>>];
PRODUCT [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>PRODUCT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: ProductId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">SKU</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ProductName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Description</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VendorId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">CategoryId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">CurrentUnitPrice</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">ProductType</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ShelfLifeDays</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">WarrantyMonths</TD></TR></TABLE>>];
PRODUCT_CATEGORY [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>PRODUCT_CATEGORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: CategoryId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">CategoryName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">County</TD></TR></TABLE>>];
REGION [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>REGION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: RegionId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">RegionName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">County</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Description</TD></TR></TABLE>>];
SALE [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>SALE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: SaleId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StoreId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">CustomerId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">SoldAt</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Description</TD></TR></TABLE>>];
SALE_LINE [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>SALE_LINE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: SaleId, ProductId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Quantity</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">UnitPriceAtSale</TD></TR></TABLE>>];
STORE [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>STORE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: StoreId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">RegionId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StoreName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">City</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StreetAddress</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StateCode</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">PostalCode</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">ManagerName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Phone</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">OpeningHours</TD></TR></TABLE>>];
STORE_PRODUCT [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>STORE_PRODUCT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: StoreId, ProductId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StockQuantity</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ReorderLevel</TD></TR></TABLE>>];
VENDOR [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>VENDOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">DETERMINANT: VendorId</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">↓ full dependency</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">VendorName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ContactName</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Email</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Phone</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StreetAddress</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">City</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StateCode</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">PostalCode</TD></TR></TABLE>>];
{rank=same; CUSTOMER; PRODUCT; PRODUCT_CATEGORY;}
{rank=same; REGION; SALE; SALE_LINE;}
{rank=same; STORE; STORE_PRODUCT; VENDOR;}
CUSTOMER -> REGION [style=invis];
PRODUCT -> SALE [style=invis];
PRODUCT_CATEGORY -> SALE_LINE [style=invis];
REGION -> STORE [style=invis];
SALE -> STORE_PRODUCT [style=invis];
SALE_LINE -> VENDOR [style=invis];

}
