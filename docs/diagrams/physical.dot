digraph G {
 graph [bgcolor="#F8FAFC", pad="0.35", nodesep="0.45", ranksep="0.75", fontname="DejaVu Sans", fontsize=20, labelloc=t, labeljust=l];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10];
 edge [fontname="DejaVu Sans", fontsize=9, color="#64748B", arrowsize=0.7];
 label="MARKETHUB / SQL Server physical model"; rankdir=LR;
REGION [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>REGION</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK RegionId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">RegionName : nvarchar(80) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">County : nvarchar(80) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Description : nvarchar(250) NULL</TD></TR></TABLE>>];
STORE [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>STORE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK StoreId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">FK RegionId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StoreName : nvarchar(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">City : nvarchar(80) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StreetAddress : nvarchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StateCode : char(2) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PostalCode : varchar(10) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ManagerName : nvarchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Phone : varchar(25) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">OpeningHours : nvarchar(150) NULL</TD></TR></TABLE>>];
VENDOR [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>VENDOR</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK VendorId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">VendorName : nvarchar(100) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">ContactName : nvarchar(100) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Email : nvarchar(254) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Phone : varchar(25) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StreetAddress : nvarchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">City : nvarchar(80) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StateCode : char(2) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PostalCode : varchar(10) NULL</TD></TR></TABLE>>];
PRODUCT_CATEGORY [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>PRODUCT_CATEGORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK CategoryId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">CategoryName : nvarchar(80) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">County : nvarchar(80) NULL</TD></TR></TABLE>>];
PRODUCT [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>PRODUCT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK ProductId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">SKU : varchar(30) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">ProductName : nvarchar(120) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Description : nvarchar(250) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">FK VendorId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">FK CategoryId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">CurrentUnitPrice : decimal(12,2) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ProductType : char(1) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">ShelfLifeDays : int NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">WarrantyMonths : int NULL</TD></TR></TABLE>>];
CUSTOMER [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>CUSTOMER</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK CustomerId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">FirstName : nvarchar(50) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">LastName : nvarchar(50) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">CustomerName : computed expression (derived)</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Phone : varchar(25) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StreetAddress : nvarchar(150) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">City : nvarchar(80) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">StateCode : char(2) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PostalCode : varchar(10) NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">Email : nvarchar(254) NOT NULL</TD></TR></TABLE>>];
STORE_PRODUCT [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>STORE_PRODUCT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK FK StoreId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">PK FK ProductId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">StockQuantity : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">ReorderLevel : int NOT NULL</TD></TR></TABLE>>];
SALE [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>SALE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK SaleId : bigint NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">FK StoreId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">FK CustomerId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">SoldAt : datetime2(0) NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Description : nvarchar(250) NULL</TD></TR></TABLE>>];
SALE_LINE [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6"><TR><TD BGCOLOR="#0F2942" ALIGN="LEFT"><FONT COLOR="white"><B>SALE_LINE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">PK FK SaleId : bigint NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">PK FK ProductId : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#E8F4F1">Quantity : int NOT NULL</TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#FFFFFF">UnitPriceAtSale : decimal(12,2) NOT NULL</TD></TR></TABLE>>];
REGION -> STORE [label="RegionId → RegionId" headlabel="0..*" taillabel="1"];
VENDOR -> PRODUCT [label="VendorId → VendorId" headlabel="0..*" taillabel="1"];
PRODUCT_CATEGORY -> PRODUCT [label="CategoryId → CategoryId" headlabel="0..*" taillabel="1"];
STORE -> STORE_PRODUCT [label="StoreId → StoreId" headlabel="0..*" taillabel="1"];
PRODUCT -> STORE_PRODUCT [label="ProductId → ProductId" headlabel="0..*" taillabel="1"];
STORE -> SALE [label="StoreId → StoreId" headlabel="0..*" taillabel="1"];
CUSTOMER -> SALE [label="CustomerId → CustomerId" headlabel="0..*" taillabel="1"];
SALE -> SALE_LINE [label="SaleId → SaleId" headlabel="0..*" taillabel="1"];
PRODUCT -> SALE_LINE [label="ProductId → ProductId" headlabel="0..*" taillabel="1"];

}
